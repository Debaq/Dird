# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dird
artifacts
*.local

# Local LLM weights (downloaded on-demand to <app_data>/llm/, also for repo safety)
*.gguf

# Reportes de muestra pesados (no versionar; regenerables desde la app)
docs/sample-report-*.pdf

# Encrypted `.dird` exports — sensitive clinical data, never commit
*.dird

# SQLite/SQLCipher local databases
*.db
*.db-journal
*.db-wal
*.db-shm

# Environment variables (solo archivos locales personales)
.env.local
.env.development.local
.env.production.local

# Claude Code local state
.claude/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# === Validation (experiment-1-idrid / experiment-2-aptos) ===
validation/datasets/*
!validation/datasets/.gitkeep

# Large binaries / model weights — never version
validation/**/*.zip
validation/**/*.onnx
validation/**/*.pt
validation/**/*.pth
validation/**/*.npy

# Heavy local-only artifacts (overlays, COCO export, raw detection dumps)
validation/experiment-1-idrid/results/_local_heavy/
validation/**/raw_detections*.csv

# Images: version result plots, NOT raw/overlay imagery
validation/**/*.jpg
validation/**/*.jpeg
validation/**/*.tif
validation/**/*.tiff
validation/**/*.webp
validation/**/*.bmp
validation/**/*.png
!validation/**/results/**/*.png

# CSVs: version metrics/summary, raw dumps already excluded above
validation/**/*.csv
!validation/**/results/**/*.csv
validation/**/raw_detections*.csv

# Misc
validation/aptos_extracted/
validation/**/messidor_extracted/
validation/aptos_markers/
validation/__pycache__/
validation/.claude/
